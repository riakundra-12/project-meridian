# Copy to .env (already gitignored) and fill in real values.
AGENT_PROVIDER=mock
GEMINI_API_KEY=
GROQ_API_KEY=

# B5 vision extraction (src/extraction/) -- deliberately a separate model
# from chat's AGENT_PROVIDER. Verified empirically: Gemini's daily quota
# is scoped per model name, so extraction testing doesn't eat into chat's
# budget, or vice versa.
EXTRACTION_MODEL=gemini-3.5-flash
